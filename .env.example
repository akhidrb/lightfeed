# ── App (Vite exposes these to the browser) ──────────────────────────────────
# Get from: Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ── Curation script only (never exposed to browser) ──────────────────────────
# YouTube Data API v3 key: https://console.cloud.google.com/
YOUTUBE_API_KEY=your_youtube_api_key_here

# Anthropic API key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase service role key (has write access — keep secret)
# Get from: Supabase dashboard → Project Settings → API → service_role key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

